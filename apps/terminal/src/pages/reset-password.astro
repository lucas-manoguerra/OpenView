---
import { ResetPasswordForm } from '../components/auth/ResetPasswordForm';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <title>Restablecer contraseña - OpenView</title>
  </head>
  <body>
    <main>
      <ResetPasswordForm client:only="preact" />
    </main>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 400px;
        margin: 4rem auto;
        padding: 0 1rem;
      }
      main {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .reset-password-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        background: #ffffff;
      }
      .reset-password-form h2 {
        margin: 0;
        font-size: 1.5rem;
        color: #1e293b;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .field label {
        font-size: 0.875rem;
        color: #475569;
        font-weight: 500;
      }
      .field input {
        padding: 0.5rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.25rem;
        font-size: 1rem;
      }
      button {
        padding: 0.6rem;
        border: none;
        border-radius: 0.25rem;
        background: #2563eb;
        color: white;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
      }
      button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
      }
      .error-message {
        color: #dc2626;
        font-size: 0.875rem;
        background: #fef2f2;
        padding: 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid #fecaca;
      }
      .success-message {
        color: #166534;
        font-size: 0.875rem;
        background: #f0fdf4;
        padding: 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid #bbf7d0;
      }
      .footer {
        font-size: 0.875rem;
        color: #64748b;
        text-align: center;
        margin: 0;
      }
      .footer a {
        color: #2563eb;
        text-decoration: none;
      }
      .footer a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
