---
import { getAuthenticatedUser } from '../lib/supabase/middleware';

const { user, error } = await getAuthenticatedUser(Astro);

if (error || !user) {
  return Astro.redirect('/login');
}
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <title>Dashboard - OpenView</title>
  </head>
  <body>
    <main>
      <h1>Dashboard</h1>
      <p>Sesión activa: {user.email ?? user.sub}</p>
      <form action="/auth/signout" method="POST">
        <button type="submit">Cerrar sesión</button>
      </form>
    </main>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 600px;
        margin: 4rem auto;
        padding: 0 1rem;
      }
      main {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        background: #ffffff;
      }
      h1 {
        margin: 0;
        font-size: 1.75rem;
        color: #1e293b;
      }
      p {
        font-size: 1rem;
        color: #475569;
      }
      button {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 0.25rem;
        background: #dc2626;
        color: white;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        width: fit-content;
      }
      button:hover {
        background: #b91c1c;
      }
    </style>
  </body>
</html>
