---
import TerminalLayout from '../../../layouts/TerminalLayout.astro';
import { IconPlayground } from '../../../components/component-lab/IconPlayground';
---

<TerminalLayout title="Icons — Component Lab">
  <main class="min-h-screen bg-[#0b0e14] text-[#d1d4dc]">
    <header class="flex h-12 items-center justify-between border-b border-[#2a2e39] bg-[#131722] px-4">
      <a href="/component-lab" class="text-sm font-semibold text-white no-underline">← Component Lab</a>
      <span class="text-xs text-[#787b86]">Core / Icons</span>
    </header>
    <div class="mx-auto max-w-5xl space-y-6 px-5 py-8">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-widest text-[#2962ff]">Core components</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-white">Icons</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-[#787b86]">
          Catálogo centralizado basado en Lucide Preact, con tamaños, grosor de trazo y reglas
          de accesibilidad consistentes para toda la aplicación.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Iconos registrados</p>
          <p class="mt-1 text-xl font-semibold text-white">38</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Tamaños estándar</p>
          <p class="mt-1 text-xl font-semibold text-white">14 / 18 / 22 px</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Dependencias transitivas</p>
          <p class="mt-1 text-xl font-semibold text-white">0 adicionales</p>
        </div>
      </div>
      <IconPlayground client:load />
    </div>
  </main>
</TerminalLayout>
