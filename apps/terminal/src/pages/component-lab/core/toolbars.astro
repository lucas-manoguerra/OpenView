---
import TerminalLayout from '../../../layouts/TerminalLayout.astro';
import { ToolbarPlayground } from '../../../components/component-lab/ToolbarPlayground';
---

<TerminalLayout title="Toolbars — Component Lab">
  <main class="min-h-screen bg-[#0b0e14] text-[#d1d4dc]">
    <header class="flex h-12 items-center justify-between border-b border-[#2a2e39] bg-[#131722] px-4">
      <a href="/component-lab" class="text-sm font-semibold text-white no-underline">← Component Lab</a>
      <span class="text-xs text-[#787b86]">Core / Toolbars</span>
    </header>
    <div class="mx-auto max-w-5xl space-y-6 px-5 py-8">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-widest text-[#2962ff]">Core components</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-white">Toolbars</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-[#787b86]">
          Barras compactas de herramientas con grupos, estados activos, atajos, orientación y
          navegación por teclado, siguiendo el comportamiento del terminal de TradingView.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Grupos</p>
          <p class="mt-1 text-xl font-semibold text-white">4</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Herramientas</p>
          <p class="mt-1 text-xl font-semibold text-white">11</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Orientaciones</p>
          <p class="mt-1 text-xl font-semibold text-white">2</p>
        </div>
      </div>
      <ToolbarPlayground client:load />
    </div>
  </main>
</TerminalLayout>
