---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { DrawingPlayground } from '../../components/component-lab/DrawingPlayground';
---

<TerminalLayout title="Drawings — Component Lab">
  <main class="min-h-screen bg-[#0b0e14] text-[#d1d4dc]">
    <header class="flex h-12 items-center justify-between border-b border-[#2a2e39] bg-[#131722] px-4">
      <a href="/component-lab" class="text-sm font-semibold text-white no-underline">← Component Lab</a>
      <span class="text-xs text-[#787b86]">Drawings / Tools & Styles</span>
    </header>
    <div class="mx-auto max-w-5xl space-y-6 px-5 py-8">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-widest text-[#2962ff]">Drawing components</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-white">Drawings</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-[#787b86]">
          Laboratorio aislado para explorar el catálogo de herramientas, ajustar propiedades visuales
          y guardar plantillas antes de validar su integración en el gráfico.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Familias de herramientas</p>
          <p class="mt-1 text-xl font-semibold text-white">11</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Herramientas catalogadas</p>
          <p class="mt-1 text-xl font-semibold text-white">40+</p>
        </div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3">
          <p class="text-xs text-[#787b86]">Estilos integrados</p>
          <p class="mt-1 text-xl font-semibold text-white">4</p>
        </div>
      </div>
      <nav class="flex flex-wrap gap-2 text-xs">
        <a href="/component-lab/drawings/properties" class="rounded border border-[#2a2e39] px-3 py-2 text-[#d1d4dc] no-underline hover:bg-white/5">Panel de propiedades</a>
        <a href="/component-lab/drawings/coordinates" class="rounded border border-[#2a2e39] px-3 py-2 text-[#d1d4dc] no-underline hover:bg-white/5">Panel de coordenadas</a>
      </nav>
      <DrawingPlayground client:load />
    </div>
  </main>
</TerminalLayout>
