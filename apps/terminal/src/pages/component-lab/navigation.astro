---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { NavigationPlayground } from '../../components/component-lab/NavigationPlayground';
---

<TerminalLayout title="Navigation — Component Lab">
  <main class="min-h-screen bg-[#0b0e14] text-[#d1d4dc]">
    <header class="flex h-12 items-center justify-between border-b border-[#2a2e39] bg-[#131722] px-4">
      <a href="/component-lab" class="text-sm font-semibold text-white no-underline">← Component Lab</a>
      <span class="text-xs text-[#787b86]">Navigation / Tabs & Menus</span>
    </header>
    <div class="mx-auto max-w-5xl space-y-6 px-5 py-8">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-widest text-[#2962ff]">Navigation components</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-white">Tabs & Menus</h1>
        <p class="mt-2 text-sm leading-6 text-[#787b86]">Navegación compacta, estados activos, accesibilidad y operación por teclado.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3"><p class="text-xs text-[#787b86]">Componentes</p><p class="mt-1 text-xl font-semibold text-white">2</p></div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3"><p class="text-xs text-[#787b86]">Controles de teclado</p><p class="mt-1 text-xl font-semibold text-white">6+</p></div>
        <div class="rounded-md border border-[#2a2e39] bg-[#131722] p-3"><p class="text-xs text-[#787b86]">Estados accesibles</p><p class="mt-1 text-xl font-semibold text-white">4+</p></div>
      </div>
      <NavigationPlayground client:only="preact" />
    </div>
  </main>
</TerminalLayout>
