---
import '../styles/global.css';

type Props = {
  title?: string;
};

const { title = 'OpenView — Free Market Terminal' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" />
    <meta
      name="description"
      content="OpenView es una plataforma gratuita y extensible de análisis de mercados."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
