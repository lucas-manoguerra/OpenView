{
  "$schema": "https://cloudflare-workers.cloudflareworkers.com/config_schema_2025.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "openview-terminal",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
